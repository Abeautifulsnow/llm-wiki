{
  "name": "@llm-wiki/sdk",
  "version": "1.0.0",
  "description": "TypeScript KnowledgeProvider SDK for llm-wiki-server (agent protocol v1)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./embed": "./src/embed.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build --silent && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
